{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/playlist.m3u",
      "destination": "/api/playlist"
    }
  ],
  "headers": [
    {
      "source": "/playlist.m3u",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/x-mpegurl; charset=utf-8"
        }
      ]
    }
  ]
}